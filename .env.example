# Fournisseur WhatsApp : baileys (par défaut) ou cloud
BOT_PROVIDER=baileys

# Token BotFather — ne jamais committer le vrai token
TELEGRAM_BOT_TOKEN=
# ID numériques séparés par des virgules
TELEGRAM_ADMIN_IDS=8724079334

# Meta WhatsApp Cloud API — requis seulement avec BOT_PROVIDER=cloud
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_VERIFY_TOKEN=
META_APP_SECRET=
META_GRAPH_VERSION=v23.0
META_WEBHOOK_PORT=3000
META_WEBHOOK_HOST=0.0.0.0
META_REPLY_DELAY_MS=3000

# IA privée : désactivée par défaut. Activez-la uniquement après consentement utilisateur.
PRIVATE_AI_ENABLED=false
PRIVATE_AI_MODEL=gpt-5-mini
# OPENAI_API_KEY=
# OPENAI_API_BASE=https://api.openai.com/v1
