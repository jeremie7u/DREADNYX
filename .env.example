# Fournisseur WhatsApp : baileys, cloud ou hybrid
BOT_PROVIDER=baileys

# Mode hybride : nécessite un numéro Baileys et un autre numéro Meta Cloud API
HYBRID_BAILEYS_ENABLED=true

# Préfixes autorisés, strictement limités à ., / et *
COMMAND_PREFIXES=.,/,*

# Identifiant de session Baileys ; inutile en mode Meta Cloud API
SESSION_ID=default
SESSION_DIR=auth_info_baileys
SETTINGS_WATCH_ENABLED=false

# Persistance Render Free : stockage S3-compatible (R2, S3, MinIO, etc.).
# Laissez SESSION_BACKUP_ENABLED=false si vous utilisez un disque persistant.
SESSION_BACKUP_ENABLED=false
SESSION_BACKUP_INTERVAL_MS=60000
SESSION_BACKUP_PREFIX=dreadnyx-sessions
SESSION_BACKUP_KEY=
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Token BotFather — ne jamais committer le vrai token
TELEGRAM_BOT_TOKEN=
# ID numériques séparés par des virgules
TELEGRAM_ADMIN_IDS=8724079334

# Meta WhatsApp Cloud API — requis seulement avec BOT_PROVIDER=cloud
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_VERIFY_TOKEN=
META_APP_SECRET=
META_GRAPH_VERSION=v23.0
META_WEBHOOK_PORT=3000
META_WEBHOOK_HOST=0.0.0.0
META_REPLY_DELAY_MS=3000

# IA privée : désactivée par défaut. Activez-la uniquement après consentement utilisateur.
PRIVATE_AI_ENABLED=false
PRIVATE_AI_MODEL=gpt-5-mini
# OPENAI_API_KEY=
# OPENAI_API_BASE=https://api.openai.com/v1
